# Copy to .env. Used by the backend when run locally and by docker compose.
DATABASE_URL=postgresql+psycopg://rater:rater@localhost:5432/rater
TMDB_READ_TOKEN=your_tmdb_read_access_token_here
# Signs login tokens. Optional in dev (a dev default is used); required in production.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
